# PostgreSQL connection (Compose defaults shown; change for local deployment)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=text2sql
DB_USER=text2sql
DB_PASSWORD=change-me
# Optional full SQLAlchemy URL overrides the DB_* connection fields.
# DATABASE_URL=postgresql+psycopg://text2sql:change-me@localhost:5432/text2sql

# Optional OpenAI-compatible chat completions provider. Leave the key blank to use the built-in offline generator.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Repair loop safety limit; the service clamps this to 1-3 attempts.
MAX_ATTEMPTS=3

# Host port for FastAPI when using Docker Compose.
API_PORT=8000